{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Техно: Redis (Docker)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "-d",
        "--wait",
        "redis"
      ],
      "problemMatcher": []
    },
    {
      "label": "Техно: FastAPI",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "uvicorn",
        "backend.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Техно: React",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Техно: запустить MVP",
      "dependsOn": [
        "Техно: FastAPI",
        "Техно: React"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
