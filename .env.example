# Copy to .env. Development generates a persistent random key in backend/storage/jwt.key.
SKETCH_ENVIRONMENT=development
SKETCH_STORAGE=backend/storage
SKETCH_REDIS_URL=redis://127.0.0.1:6380/0
SKETCH_REDIS_PREFIX=techno:
SKETCH_ACCESS_TTL_SECONDS=900
SKETCH_REFRESH_TTL_SECONDS=2592000
SKETCH_COOKIE_SECURE=false
# Production: a random secret of at least 32 bytes, HTTPS and cookie_secure=true.
# SKETCH_JWT_SECRET=
# SKETCH_TRUSTED_ORIGINS=["https://your-domain.example"]
